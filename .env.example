# Copie para .env e preencha. NUNCA versione o .env.
# Credenciais em https://my.telegram.org -> API development tools (valores abaixo são FICTÍCIOS)
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# Canal de origem: @username, link t.me ou ID numérico (veja: python tg_videos.py chats)
TG_CHANNEL=-1001234567890

# Destino padrão do upload (pode ser sobrescrito com --to)
#   telegram:<id ou @canal>   canal privado vazio e dedicado (você precisa ser admin)
#   rclone:<remote:pasta>     ex.: rclone:gdrive:Cursos/MeuCanal
#   local:<pasta>             ex.: local:/home/usuario/Videos/MeuCanal
DEST_DEFAULT=telegram:-1009876543210

# Conta Premium? Ajusta padrões de lote/concorrência e limite de upload (2 GB -> 4 GB)
TG_PREMIUM=false

# Limite de caracteres da legenda da SUA conta (1024 na conta comum; Premium permite mais —
# confira o valor atual antes de aumentar). Acima disso a legenda vai como mensagem de texto.
TG_CAPTION_LIMIT=1024

# Onde ficam sessão, manifest e arquivos (relativo à pasta do script). Mantenha no
# filesystem Linux do WSL (~/...) — /mnt/c e /mnt/d são bem mais lentos.
DATA_DIR=data
